# ─────────────────────────────────────────────────────────────────────────────
# BlueprintBuster — Plugin-local .gitignore
# Paths are relative to the plugin root (Plugins/BlueprintBuster/).
# ─────────────────────────────────────────────────────────────────────────────


# ── Unreal Engine build artifacts ────────────────────────────────────────────
# Generated by UBT on every compile; fully reproducible from source.

/Binaries/
/Intermediate/
/Saved/


# ── JetBrains Rider ───────────────────────────────────────────────────────────
# Per-project IDE state and local inspection settings.

/.idea/
*.sln.DotSettings.user


# ── Visual Studio ─────────────────────────────────────────────────────────────
# Solution / project files are regenerated by "Generate Visual Studio project
# files"; local user settings and hidden VS state dirs must not be committed.

/.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.VisualX
*.suo
*.user


# ── Visual Studio Code ────────────────────────────────────────────────────────
# Workspace-local launch configs and extension settings.

/.vscode/


# ── C++ compiler artifacts ────────────────────────────────────────────────────
# Object files, precompiled headers, and linker intermediates that can
# occasionally land outside the standard /Intermediate/ tree.

*.o
*.obj
*.pch
*.gch
*.pdb
*.ilk
*.exp
*.lib
*.a


# ── OS-generated noise ────────────────────────────────────────────────────────
# macOS Finder metadata, Windows Explorer thumbnails and layout files.

.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
